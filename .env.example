# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (server-only)
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# External payment links (no processor is implemented in-app)
PROFESSIONAL_PAYMENT_LINK=
ENTERPRISE_PAYMENT_LINK=
# Shared secret used to verify signed payment webhooks (HMAC-SHA256 of raw body, hex, header x-factorypilot-signature)
PAYMENT_WEBHOOK_SECRET=

# Credit allowances granted when a subscription is activated. Leave blank until final
# quantities are decided: usage is then metered but not capped.
PROFESSIONAL_MONTHLY_CREDITS=
ENTERPRISE_MONTHLY_CREDITS=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
